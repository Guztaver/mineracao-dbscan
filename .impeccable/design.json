  "components": [
    {
      "name": "Primary Action Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "High-contrast action that places the submitted measurement on the map.",
      "html": "<button class=\"ds-btn-primary\" type=\"button\"><span>Verificar no mapa</span><svg viewBox=\"0 0 20 20\" aria-hidden=\"true\"><path d=\"M3 10h13M10 4l6 6-6 6\"/></svg></button>",
      "css": ".ds-btn-primary{min-height:48px;display:flex;align-items:center;justify-content:center;gap:10px;padding:0 16px;border:1px solid #fbd18f;border-radius:9px;background:#ffc36b;color:#172333;font:600 15px \"Barlow Semi Condensed\",sans-serif;cursor:pointer;transition:background-color .16s ease,transform .16s ease}.ds-btn-primary:hover{background:#ffd18a;transform:translateY(-1px)}.ds-btn-primary:focus-visible{outline:3px solid #ffc36b;outline-offset:3px}.ds-btn-primary svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}"
    },
    {
      "name": "Measurement Field",
      "kind": "input",
      "refersTo": "field",
      "description": "Numeric reading with its unit held in a single well.",
      "html": "<label class=\"ds-field\"><span>Consumo</span><span class=\"ds-input\"><input type=\"number\" value=\"1.2\"><span>kWh</span></span></label>",
      "css": ".ds-field{display:grid;gap:5px;color:#f0f5f6;font:600 15px \"Barlow Semi Condensed\",sans-serif}.ds-input{min-height:49px;display:flex;align-items:center;border:1px solid #57758a;border-radius:9px;background:#0c2236}.ds-input input{width:100%;min-width:0;border:0;outline:0;background:transparent;color:#f0f5f6;padding:11px 12px;font:400 18px \"Barlow Semi Condensed\",sans-serif}.ds-input>span{padding:0 13px 0 4px;color:#a6bbc6;font-size:14px}.ds-input:focus-within{border-color:#b9d9e5}.ds-input:focus-within input:focus-visible{outline:0}"
    },
    {
      "name": "Contour Map Panel",
      "kind": "custom",
      "refersTo": "density-map",
      "description": "The central plot surface for core-point density, simulated readings, and a submitted point.",
      "html": "<section class=\"ds-map\"><h3>Campo de densidade</h3><p>Hora do dia × consumo em kWh</p><canvas aria-label=\"Mapa de densidade calculado a partir dos pontos centrais do DBSCAN\"></canvas></section>",
      "css": ".ds-map{overflow:hidden;border:1px solid #29485f;border-radius:14px;background:#0a2033;color:#f0f5f6;padding:20px}.ds-map h3{margin:0;font:600 22px/1.1 \"Barlow Semi Condensed\",sans-serif}.ds-map p{margin:5px 0 14px;color:#a6bbc6;font:400 14px \"Barlow Semi Condensed\",sans-serif}.ds-map canvas{display:block;width:100%;height:240px;background:#0a2033;border-block:1px solid #29485f}"
    },
    {
      "name": "Reading Result",
      "kind": "custom",
      "refersTo": "result",
      "description": "Text and a state tint identify whether the new point lies within the modeled density.",
      "html": "<div class=\"ds-result\"><strong>Leitura dentro do padrão</strong><span>Este ponto fica próximo de uma região densa.</span></div>",
      "css": ".ds-result{display:grid;gap:4px;padding:12px 13px;border:1px solid #4c9c82;border-radius:9px;background:#123c3a;color:#ddf8eb;font:400 14px/1.4 \"Barlow Semi Condensed\",sans-serif}.ds-result strong{font-weight:600}.ds-result[aria-invalid=\"true\"]{border-color:#bd6c68;background:#462829;color:#ffe4e0}"
    },
    {
      "name": "Dataset Status",
      "kind": "chip",
      "refersTo": "dataset-status",
      "description": "A small status row labels the dataset as a demonstration before the chart is read.",
      "html": "<span class=\"ds-status\"><i></i>Base de demonstração</span>",
      "css": ".ds-status{display:inline-flex;align-items:center;gap:8px;border:1px solid #41647b;border-radius:999px;padding:7px 12px;color:#d0e4ed;font:400 13px \"Barlow Semi Condensed\",sans-serif}.ds-status i{width:8px;height:8px;border-radius:50%;background:#76d6b0;box-shadow:0 0 0 4px #76d6b01d}"
    },
    {
      "name": "Disclosure",
      "kind": "custom",
      "refersTo": "explanation",
      "description": "Expandable method and metric information stays available without competing with the core task.",
      "html": "<details class=\"ds-disclosure\"><summary>Como funciona<svg viewBox=\"0 0 18 18\" aria-hidden=\"true\"><path d=\"m4 7 5 5 5-5\"/></svg></summary><p>DBSCAN calcula grupos a partir de pontos próximos.</p></details>",
      "css": ".ds-disclosure{border:1px solid #29485f;border-radius:14px;background:#0c2236;color:#f0f5f6}.ds-disclosure summary{min-height:56px;display:flex;align-items:center;justify-content:space-between;padding:11px 15px;cursor:pointer;list-style:none;font:600 18px \"Barlow Semi Condensed\",sans-serif}.ds-disclosure summary:focus-visible{outline:3px solid #ffc36b;outline-offset:3px}.ds-disclosure svg{width:17px;height:17px;fill:none;stroke:currentColor;stroke-width:1.6}.ds-disclosure p{padding:0 15px 15px;color:#a6bbc6;font:400 14px/1.5 \"Barlow Semi Condensed\",sans-serif}"
    }
  ],
  "narrative": {
    "northStar": "Carta de Sondagem",
    "overview": "Pulso treats the consumption chart as a field to investigate. Density contours are calculated from the model's DBSCAN core points; a submitted reading is plotted in the same coordinate space. Familiar web controls keep the data task clear, while synthetic readings remain labeled as demonstrations.",
    "keyCharacteristics": [
      "Data-derived contours are the signature visual.",
      "Amber marks the primary action and the user's submitted reading.",
      "The chart and input stay readable as a standard web tool.",
      "Synthetic data and model limits remain visible in context."
    ],
    "rules": [
      {
        "name": "The Single Marker Rule",
        "body": "Amber belongs to the primary action and the user's input. Keep simulated anomaly points violet and typical points blue so the legend remains unambiguous.",
        "section": "colors"
      },
      {
        "name": "The One-Family Rule",
        "body": "Use Barlow Semi Condensed throughout; do not introduce a display face for decoration.",
        "section": "typography"
      },
      {
        "name": "The Layered Field Rule",
        "body": "Use a darker plot plane inside a raised page surface; use borders to clarify panel edges.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep sampled data, density lines, and submitted marker distinct in the legend.",
      "Do use contours only for the calculated DBSCAN core-point field.",
      "Do preserve the synthetic-data note and limitations near the task.",
      "Do keep chart labels and controls readable on small screens."
    ],
    "donts": [
      "Don't use the anomaly alert as a diagnosis or prediction.",
      "Don't use amber for simulated anomaly points.",
      "Don't add decorative contour geometry outside the chart field.",
      "Don't rely on color alone for reading status."
    ]
  }
}
